<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".act.GameAct">

    <LinearLayout
        android:id="@+id/layoutRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <include layout="@layout/item_game_toolbar" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/bkg" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                app:layout_constraintTop_toBottomOf="@+id/ivOriginal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/vgBoardContainer">

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:layout_marginEnd="24dp"/>

                <TextView
                    android:id="@+id/tvMoves"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moves: 0"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/ivOriginal"
                android:layout_width="@dimen/image_preview_size"
                android:layout_height="@dimen/image_preview_size"
                android:contentDescription="@string/app_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@mipmap/ic_launcher" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/vgBoardContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/layoutBottom"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivOriginal">


                <com.helpmepls.slidepuzzle.game.GameBoard
                    android:id="@+id/boardView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:background="@color/board_active_trans"
                    android:elevation="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="H,1:1"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/layoutBottom"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btShuffle"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="@dimen/game_button_width"
                    android:layout_height="@dimen/game_button_height"
                    android:text="@string/shuffle"
                    android:textAppearance="@style/TextAppearance.App.ButtonText"
                    app:backgroundTint="@color/md_theme_primary"
                    app:cornerRadius="@dimen/button_corner_radius"
                    app:elevation="@dimen/elevation_button" />

                <ImageButton
                    android:id="@+id/btUndo"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="56dp"
                    android:layout_height="@dimen/game_button_height"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:contentDescription="Undo"
                    android:padding="0dp"
                    app:cornerRadius="@dimen/button_corner_radius"
                    app:strokeColor="@color/md_theme_primary"
                    app:strokeWidth="2dp" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btReset"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="@dimen/game_button_width"
                    android:layout_height="@dimen/game_button_height"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:text="@string/reset"
                    android:textAppearance="@style/TextAppearance.App.LabelLarge"
                    android:textColor="@color/md_theme_primary"
                    app:cornerRadius="@dimen/button_corner_radius"
                    app:strokeColor="@color/md_theme_primary"
                    app:strokeWidth="2dp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
