<?xml version="1.0" encoding="utf-8"?>
<!-- P2 (Task 09): gop 2 FrameLayout + LinearLayout wrapper thua thanh 1 root LinearLayout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".act.GameAct">

    <include layout="@layout/item_game_toolbar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Removed static background to show Liquid Gradient -->

        <LinearLayout
            android:id="@+id/topInfoBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivOriginal"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/neon_ring"
                android:contentDescription="@string/image_original_desc"
                android:padding="4dp"
                android:scaleType="centerCrop"
                tools:src="@mipmap/ic_launcher" />

            <!-- Glass Panel for Stats — elevation tạo colored drop-shadow qua NeonGlow. -->
            <LinearLayout
                android:id="@+id/statsPanel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/neon_glass_panel"
                android:baselineAligned="false"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="?attr/colorPrimary"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="10"
                    android:text="⏱ 00:00"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="12dp"
                    android:alpha="0.3"
                    android:background="@color/glass_stroke" />

                <TextView
                    android:id="@+id/tvMoves"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="@color/neon_lime_glow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="10"
                    android:text="📊 0"
                    android:textColor="@color/neon_lime"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/vgBoardContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/layoutBottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topInfoBar">

            <!-- Ambient bloom toa sang tu tam board ra nen (radial gradient oval). -->
            <ImageView
                android:id="@+id/boardAmbientGlow"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/neon_board_bloom"
                android:scaleType="fitXY"
                android:alpha="0.85"
                android:elevation="0dp"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.helpmepls.slidepuzzle.game.GameBoard
                android:id="@+id/boardView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:background="@android:color/transparent"
                android:elevation="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Wave 10: viền gradient động (SweepGradient xoay). clickable=false không chặn touch board. -->
            <com.helpmepls.slidepuzzle.v.NeonBorderView
                android:id="@+id/neonBorderView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="false"
                android:elevation="9dp"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Bottom Glass Dock — elevation tạo colored drop-shadow qua NeonGlow. -->
        <LinearLayout
            android:id="@+id/layoutBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/neon_glass_panel"
            android:baselineAligned="false"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btShuffle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/neon_btn_primary"
                android:text="@string/shuffle"
                android:textAllCaps="true"
                android:textColor="@color/neon_text_primary"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btUndo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/neon_btn_primary"
                android:contentDescription="@string/undo_action"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_undo_neon" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btReset"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/neon_btn_danger"
                android:text="@string/reset"
                android:textAllCaps="true"
                android:textColor="@color/neon_text_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Wave 11: confetti overlay toàn màn; GONE mặc định, VISIBLE khi win. -->
        <com.helpmepls.slidepuzzle.v.NeonParticleView
            android:id="@+id/particleView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
