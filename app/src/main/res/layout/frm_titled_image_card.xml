<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vgTitledImage"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/neon_bg_surface"
        card_view:cardCornerRadius="16dp"
        card_view:cardElevation="6dp"
        card_view:cardUseCompatPadding="true"
        card_view:strokeColor="@color/neon_cyan_glow"
        card_view:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="0dp"
            android:orientation="vertical"
            tools:ignore="UseCompoundDrawables">

            <com.helpmepls.slidepuzzle.v.SquareImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:contentDescription="@string/puzzle_image_desc"
                android:scaleType="fitXY"
                tools:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.App.CardTitle"
                android:textColor="@color/neon_text_secondary"
                android:visibility="gone"
                tools:text="@string/app_name"
                tools:visibility="visible" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
