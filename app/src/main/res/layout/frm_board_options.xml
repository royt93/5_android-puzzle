<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/item_game_toolbar" />

        <!-- Bo FrameLayout wrapper thua (UselessParent): ConstraintLayout lam con truc tiep. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/vgBoardOptions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            tools:context=".frm.BoardOptionsFrm">

                <in.srain.cube.views.GridViewWithHeaderAndFooter
                    android:id="@+id/gvImages"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:clipToPadding="false"
                    android:numColumns="2"
                    android:paddingBottom="80dp"
                    android:stretchMode="columnWidth"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/layoutFooter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Floating Footer Panel -->
                <LinearLayout
                    android:id="@+id/layoutFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/neon_glass_panel"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="4dp"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/btnRate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/rate_app"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:shadowColor="?attr/colorPrimary"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="12"
                        app:drawableTopCompat="@drawable/ic_rate"
                        android:drawablePadding="2dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:padding="8dp"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/glass_stroke"
                        android:layout_gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/btnMore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/more_apps"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:shadowColor="?attr/colorPrimary"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="12"
                        app:drawableTopCompat="@drawable/ic_more"
                        android:drawablePadding="2dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:padding="8dp"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/glass_stroke"
                        android:layout_gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/btnShare"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/share_app"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:shadowColor="?attr/colorPrimary"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="12"
                        app:drawableTopCompat="@drawable/ic_share"
                        android:drawablePadding="2dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:padding="8dp"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/glass_stroke"
                        android:layout_gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/btnAbout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/about"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:shadowColor="?attr/colorPrimary"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="12"
                        app:drawableTopCompat="@drawable/ic_about"
                        android:drawablePadding="2dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:padding="8dp"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/glass_stroke"
                        android:layout_gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/btnSettings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="11sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:text="@string/settings"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:shadowColor="?attr/colorPrimary"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="12"
                        app:drawableTopCompat="@drawable/ic_settings"
                        android:drawablePadding="2dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:padding="8dp"/>

                </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
