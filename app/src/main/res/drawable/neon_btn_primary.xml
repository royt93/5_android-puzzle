<?xml version="1.0" encoding="utf-8"?>
<!-- Nut primary: glass nen elevated + vien cyan glow + ripple cyan. Wave 1 F3. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/neon_cyan_glow">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_bg_elevated" />
            <corners android:radius="@dimen/neon_corner" />
            <stroke
                android:width="@dimen/glow_stroke"
                android:color="@color/neon_cyan" />
        </shape>
    </item>
</ripple>
