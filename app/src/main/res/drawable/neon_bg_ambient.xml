<?xml version="1.0" encoding="utf-8"?>
<!-- Nen toi + 1 bloom radial cyan. 2 lop (giam overdraw 3x->2x). Wave 1 F3 / 05 M5. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_bg_deep" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.18"
                android:centerY="0.12"
                android:gradientRadius="560dp"
                android:startColor="@color/neon_cyan_bloom"
                android:endColor="@color/neon_cyan_bloom_out" />
        </shape>
    </item>
</layer-list>
