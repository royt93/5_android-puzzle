<resources>
    <!-- NEON base theme (Wave 1 F2) - candy-neon tren nen toi -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary = cyan accent -->
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorOnPrimary">@color/neon_text_on_accent</item>
        <item name="colorPrimaryContainer">@color/neon_bg_elevated</item>
        <item name="colorOnPrimaryContainer">@color/neon_text_primary</item>

        <!-- Secondary = magenta accent -->
        <item name="colorSecondary">@color/neon_magenta</item>
        <item name="colorOnSecondary">@color/neon_text_on_accent</item>
        <item name="colorSecondaryContainer">@color/neon_bg_elevated</item>
        <item name="colorOnSecondaryContainer">@color/neon_text_primary</item>

        <!-- Tertiary = lime accent -->
        <item name="colorTertiary">@color/neon_lime</item>
        <item name="colorOnTertiary">@color/neon_text_on_accent</item>
        <item name="colorTertiaryContainer">@color/neon_bg_elevated</item>
        <item name="colorOnTertiaryContainer">@color/neon_text_primary</item>

        <!-- Surface = dark base -->
        <item name="colorSurface">@color/neon_bg_surface</item>
        <item name="colorOnSurface">@color/neon_text_primary</item>
        <item name="colorSurfaceVariant">@color/neon_bg_elevated</item>
        <item name="colorOnSurfaceVariant">@color/neon_text_secondary</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/neon_bg_deep</item>
        <item name="colorOnBackground">@color/neon_text_primary</item>

        <!-- Other -->
        <item name="colorOutline">@color/glass_stroke</item>

        <!-- Window settings -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/neon_bg_ambient</item>
        <item name="android:statusBarColor">@color/neon_bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/neon_bg_deep</item>

        <!-- Typography -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.DisplayLarge</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.HeadlineLarge</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.LabelLarge</item>

        <!-- Component customizations -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>

        <!-- Toolbar text colors -->
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
    </style>

    <!-- Modern Toolbar Theme (neon) -->
    <style name="AppToolbarTheme" parent="ThemeOverlay.Material3.Dark">
        <item name="android:background">@color/neon_bg_surface</item>
        <item name="android:textColorPrimary">@color/neon_text_primary</item>
        <item name="android:textColorSecondary">@color/neon_text_secondary</item>
        <item name="colorOnSurface">@color/neon_text_primary</item>
        <item name="colorControlNormal">@color/neon_cyan</item>
        <item name="titleTextColor">@color/neon_text_primary</item>
        <item name="subtitleTextColor">@color/neon_text_secondary</item>
    </style>

    <!-- Splash Screen Theme (neon - tranh flash do luc cold start) -->
    <style name="SplashTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/neon_bg_ambient</item>
        <item name="android:statusBarColor">@color/neon_bg_deep</item>
        <item name="android:navigationBarColor">@color/neon_bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Component Styles -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textAppearance">@style/TextAppearance.App.LabelLarge</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="elevation">@dimen/elevation_button</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textAppearance">@style/TextAppearance.App.LabelLarge</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/neon_cyan_glow</item>
        <item name="cardBackgroundColor">@color/neon_bg_surface</item>
    </style>

    <!-- Toolbar Style (neon) -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/neon_text_primary</item>
        <item name="subtitleTextColor">@color/neon_text_secondary</item>
        <item name="android:textColorPrimary">@color/neon_text_primary</item>
        <item name="android:textColorSecondary">@color/neon_text_secondary</item>
    </style>

    <!-- Game specific styles -->
    <style name="Widget.App.GameButton" parent="Widget.App.Button">
        <item name="android:layout_width">@dimen/game_button_width</item>
        <item name="android:layout_height">@dimen/game_button_height</item>
    </style>

    <style name="Widget.App.GameButton.Outlined" parent="Widget.App.Button.Outlined">
        <item name="android:layout_width">@dimen/game_button_width</item>
        <item name="android:layout_height">@dimen/game_button_height</item>
    </style>
</resources>
